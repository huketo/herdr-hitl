# herdr-hitl secrets.
#
# Copy this file into the plugin config directory, then lock it down:
#
#   cp .env.example "$(herdr plugin config-dir huketo.hitl)/.env"
#   chmod 600 "$(herdr plugin config-dir huketo.hitl)/.env"
#
# Values here override the matching keys in config.toml. Never commit a filled-in
# copy: these tokens grant full control of the bot. Restart the daemon after
# editing (`herdr-hitl daemon restart`).

# Bot token from @BotFather, shape "<digits>:<base64ish>". See docs/setup-telegram.md.
HITL_TELEGRAM_BOT_TOKEN=

# Numeric chat to deliver questions to. Your own user id for a DM, or a negative
# id for a group. Obtain it from getUpdates after messaging the bot once.
HITL_TELEGRAM_CHAT_ID=

# Bot token from the Discord developer portal, Bot > Reset Token. See docs/setup-discord.md.
HITL_DISCORD_BOT_TOKEN=

# Channel snowflake to post questions into. Leave blank to DM HITL_DISCORD_USER_ID instead.
HITL_DISCORD_CHANNEL_ID=

# Your own user snowflake. Used for DM delivery and for @-mentioning you in a channel.
HITL_DISCORD_USER_ID=

# Transports used when `ask` does not pass --transport. Comma-separated,
# in delivery order: telegram, discord, or "telegram,discord" for both.
HITL_TRANSPORTS=telegram

# Default deadline for `ask` when --timeout is absent. 0 waits forever.
HITL_TIMEOUT=30m
